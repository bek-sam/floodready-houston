# DOMAIN comes from the environment (compose). Use e.g. floodready.tech or 1-2-3-4.sslip.io
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv/dist
		# Service worker must always be revalidated so updates ship immediately
		@sw path /sw.js
		header @sw Cache-Control "no-cache"
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		# Hashed build assets are immutable
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
