# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional extra keys (comma-separated); rotated with models when a key/model hits 429
GEMINI_API_KEYS=
ELEVENLABS_API_KEY=
BACKBOARD_API_KEY=
# Tiger Data (Postgres/TimescaleDB) connection string; leave empty to use local SQLite
DATABASE_URL=
# Optional, only for 3D replay
MAPBOX_TOKEN=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Comma-separated browser origins allowed by CORS (default: http://localhost:5173,http://127.0.0.1:5173)
ALLOWED_ORIGINS=
# Per-IP rate limits (requests/minute). Venue Wi-Fi shares one IP, keep generous.
RATE_ASK=60
RATE_PUSH=20
RATE_PLAN=40
# Paid / upstream-limited endpoints (per IP per minute; check-in calls are per 10 minutes)
RATE_VOICE=30
RATE_EL_AGENT=10
RATE_PROFILE=30
RATE_ROUTE=30
RATE_SMS=20
RATE_CHECKIN_CALL=3
RATE_GEOCODE=60
# Gemini Live WebSocket: max concurrent sessions per IP (4 in total)
LIVE_MAX_PER_IP=2
GEMINI_VOICE_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
ELEVENLABS_AGENT_ID=
# Offline demo mode: 1 = answer recorded requests from data/demo_snapshot/ (never set in production)
DEMO_SNAPSHOT=

# SMS / voice check-in (leave empty: simulator and /api/sms/inbound work; no real SMS or calls are ever sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Public URL Twilio posts to (only needed behind a proxy, for signature validation)
TWILIO_WEBHOOK_URL=
# /api/sms/simulate replies but does NOT save ALERTS ON/OFF or STOP/START unless SMS_SIMULATE=1 (or DEMO_SNAPSHOT=1)
SMS_SIMULATE=
# /api/checkin/call places real phone calls: disabled unless CHECKIN_CALLS=1 (also needs TWILIO_*)
CHECKIN_CALLS=

# Jev (TypeSafe AI "System One") decision layer: optional, paid, hosted only. Jev decides (intent, danger,
# tools, complexity, answer guardrail); Gemini still writes. Empty key = today's rule-based behaviour.
TYPESAFE_API_KEY=
# Pinned model id
TYPESAFE_MODEL=jev-1.13.0
# 0 turns the layer off even with a key
JEV_ENABLED=1
# Seconds per Jev call before falling back to the rules
JEV_TIMEOUT=1.2
# Minimum Jev confidence to override the regex intent or the model choice
JEV_MIN_CONF=0.75
# 1 = also trust Jev intents for non-English questions (default: regex first, only Jev's danger signal is used)
JEV_NON_EN=0
# 1 = send confidently complex questions to the multi-step LangGraph tool loop (slower; off by default)
JEV_AGENT_ROUTE=0
# Answer guardrail on /ask (unsafe floodwater advice, "official" claims, "safe" during a flood warning); 0 = off
JEV_GUARD=1
